# Copy to .env for local development. Never commit real secrets.
# Production values must come from a secret manager.

# --- Apps ---
NODE_ENV=development
APP_URL=http://localhost:3000
MAIL_FROM_NAME=İcra360

# Auth.js
AUTH_SECRET=replace-with-32+-char-random-string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# --- Postgres ---
# Superuser: migrations only
DATABASE_MIGRATE_URL=postgresql://icra360:icra360_dev@localhost:5432/icra360?schema=public
# Application role: subject to RLS
DATABASE_URL=postgresql://icra360_app:icra360_app_dev@localhost:5432/icra360?schema=public

# --- Redis / MinIO ---
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=icra360-local
S3_ACCESS_KEY=icra360_minio
S3_SECRET_KEY=icra360_minio_secret
S3_FORCE_PATH_STYLE=true

# --- Field encryption (32-byte keys, base64) ---
# openssl rand -base64 32
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
NATIONAL_ID_HMAC_PEPPER=replace-with-long-random-pepper

# --- Seed (local only, fictional data) ---
SEED_PASSWORD=Demo.Sifre.123!

# Cloud OCR / LLM stay off unless explicitly enabled later
OCR_CLOUD_ENABLED=false
LLM_EXTRACTION_ENABLED=false
