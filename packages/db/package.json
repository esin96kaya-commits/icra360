{
  "name": "@icra360/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@icra360/crypto": "workspace:*",
    "@icra360/contracts": "workspace:*",
    "@prisma/client": "^6.16.2",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
